# Cấu hình máy chủ cấp phép Nexus — copy thành .env rồi điền thật
# Email gửi key (Gmail cần App Password 16 ký tự, không dùng mật khẩu thường)
SENDMAIL_USER=youradmin@gmail.com
SENDMAIL_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=Nexus License
# Email nhận key (mail admin thiết lập key), nhiều mail cách nhau dấu phẩy
ADMIN_EMAILS=youradmin@gmail.com
# Token bảo vệ dashboard + API admin (bắt buộc khi chạy public). Rỗng = không chặn (chỉ dùng nội bộ)
ADMIN_TOKEN=doi-token-nay-thanh-chuoi-bi-mat
# Cổng chạy server
PORT=5555
